<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- lets the Shortcuts card (方方查詞（小視窗）) play recordings while another app is on screen -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- the App Group shared with the 分類詞卡 widget -->
	<key>FFAppGroup</key>
	<string>$(APP_GROUP)</string>
</dict>
</plist>
